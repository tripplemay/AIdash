# 数据库连接（腾讯云 TDSQL-C MySQL）
DATABASE_URL="mysql://root:password@host:port/aidash"

# NextAuth 密钥（使用 openssl rand -base64 32 生成）
AUTH_SECRET="your-auth-secret"

# 运行环境
NODE_ENV="production"

# ─── 课程研发模块 ───

# 功能开关（true 启用，false 或不设置则关闭）
ENABLE_RD_MODULE="false"

# OpenRouter API Key（课程研发 AI 功能所需）
OPENROUTER_API_KEY="sk-or-xxx"
